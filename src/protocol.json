        "CareProvider",
        "SchoolStaff"
      ],
      "same_roles": [
        "school"
      ]
    },
    {
      "from_role": "CareProvider",
      "can_create_groups": true,
      "direct_to_roles": [
        "Child",
        "SchoolStaff"
      ],
      "group_member_roles": [
        "Child",
        "SchoolStaff"
      ],
      "same_roles": [
        "school"
      ]
    },
    {
      "from_role": "SchoolStaff",
      "can_create_groups": true,
      "direct_to_roles": [
        "Child",
        "CareProvider"
      ],
      "group_member_roles": [
        "Child",
        "CareProvider"
      ],
      "same_roles": [
        "school"
      ]
    }
  ],
  "home": {
    "element": {
      "type": "ref",
      "path": "${role}/home.json"
    }
  },
  "connections": {
    "type": "ref",
    "path": "${role}/connections.json"
  }
}
